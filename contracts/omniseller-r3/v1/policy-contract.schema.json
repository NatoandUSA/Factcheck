{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://omniseller.local/contracts/r3/v1/policy-contract.schema.json",
  "title": "OmniSeller R3 Marketplace Policy Contract",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "policyContractId", "marketplace", "site", "locales", "effectiveFrom", "checkedAt", "verificationStatus", "approvalEligibility", "approvalCritical", "cohort", "sourceRefs", "rules"],
  "properties": {
    "schemaVersion": { "const": "omniseller.policy-contract.v1" },
    "policyContractId": { "type": "string", "minLength": 1 },
    "marketplace": { "enum": ["AMAZON", "ETSY"] },
    "site": { "const": "US" },
    "locales": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "enum": ["en-US", "es-US"] } },
    "effectiveFrom": { "type": "string", "format": "date-time" },
    "checkedAt": { "type": "string", "format": "date-time" },
    "verificationStatus": { "enum": ["PUBLIC_BASELINE", "OWNER_CONFIRMED_ACCOUNT_CATEGORY"] },
    "approvalEligibility": { "enum": ["DRAFT_ONLY", "APPROVAL_ELIGIBLE"] },
    "approvalCritical": { "const": true },
    "supersedes": { "type": ["string", "null"] },
    "cohort": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mediaClass", "productTypeIds", "categoryIds", "sellerAccountIds"],
      "properties": {
        "mediaClass": { "type": "string", "minLength": 1 },
        "productTypeIds": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
        "categoryIds": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
        "sellerAccountIds": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } }
      }
    },
    "sourceRefs": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/sourceRef" } },
    "rules": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "title": { "$ref": "#/$defs/charLimit" },
        "itemHighlights": { "$ref": "#/$defs/charLimit" },
        "bullets": {
          "type": "object",
          "additionalProperties": false,
          "required": ["targetCount", "maxChars"],
          "properties": {
            "targetCount": { "type": "integer", "minimum": 0 },
            "maxChars": { "type": ["integer", "null"], "minimum": 1 }
          }
        },
        "genericKeywords": {
          "type": "object",
          "additionalProperties": false,
          "required": ["maxUtf8Bytes", "allowCommas"],
          "properties": {
            "maxUtf8Bytes": { "type": "integer", "minimum": 1 },
            "allowCommas": { "type": "boolean" }
          }
        },
        "tags": {
          "type": "object",
          "additionalProperties": false,
          "required": ["maxCount", "targetCount", "maxChars"],
          "properties": {
            "maxCount": { "type": "integer", "minimum": 0 },
            "targetCount": { "type": "integer", "minimum": 0 },
            "maxChars": { "type": "integer", "minimum": 1 }
          }
        }
      }
    }
  },
  "allOf": [
    {
      "if": { "properties": { "marketplace": { "const": "AMAZON" } }, "required": ["marketplace"] },
      "then": { "properties": { "rules": { "type": "object", "required": ["title", "itemHighlights", "bullets", "genericKeywords"] } } }
    },
    {
      "if": { "properties": { "marketplace": { "const": "ETSY" } }, "required": ["marketplace"] },
      "then": { "properties": { "rules": { "type": "object", "required": ["title", "tags"] } } }
    },
    {
      "if": { "properties": { "verificationStatus": { "const": "PUBLIC_BASELINE" } }, "required": ["verificationStatus"] },
      "then": { "properties": { "approvalEligibility": { "const": "DRAFT_ONLY" } } }
    },
    {
      "if": { "properties": { "verificationStatus": { "const": "OWNER_CONFIRMED_ACCOUNT_CATEGORY" } }, "required": ["verificationStatus"] },
      "then": {
        "properties": {
          "approvalEligibility": { "const": "APPROVAL_ELIGIBLE" },
          "cohort": { "type": "object", "properties": { "categoryIds": { "type": "array", "minItems": 1 }, "sellerAccountIds": { "type": "array", "minItems": 1 } } },
          "sourceRefs": {
            "type": "array",
            "contains": {
              "type": "object",
              "properties": { "kind": { "enum": ["AUTHENTICATED_CAPTURE", "OWNER_ATTESTATION"] } },
              "required": ["kind", "artifactHash", "actorId"]
            }
          }
        }
      }
    }
  ],
  "$defs": {
    "charLimit": {
      "type": "object",
      "additionalProperties": false,
      "required": ["maxChars", "counting"],
      "properties": {
        "maxChars": { "type": "integer", "minimum": 1 },
        "counting": { "enum": ["UNICODE_CODE_POINTS", "UTF16_CODE_UNITS"] }
      }
    },
    "sourceRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "capturedAt"],
      "properties": {
        "kind": { "enum": ["PUBLIC_URL", "AUTHENTICATED_CAPTURE", "OWNER_ATTESTATION"] },
        "url": { "type": "string", "minLength": 1 },
        "artifactHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "capturedAt": { "type": "string", "format": "date-time" },
        "actorId": { "type": "string", "minLength": 1 }
      },
      "allOf": [
        { "if": { "properties": { "kind": { "const": "PUBLIC_URL" } }, "required": ["kind"] }, "then": { "required": ["url"] } },
        { "if": { "properties": { "kind": { "enum": ["AUTHENTICATED_CAPTURE", "OWNER_ATTESTATION"] } }, "required": ["kind"] }, "then": { "required": ["artifactHash", "actorId"] } }
      ]
    }
  }
}
