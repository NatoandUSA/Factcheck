{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://omniseller.local/contracts/r3/v1/track-a-handoff-manifest.schema.json",
  "title": "Track A Non-Canonical Handoff Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "packageId",
    "classification",
    "authority",
    "watermark",
    "generatedAt",
    "productTruthState",
    "requiresTrackBRevalidation",
    "keywordAccounting",
    "bindings",
    "components"
  ],
  "properties": {
    "schemaVersion": { "const": "omniseller.track-a-handoff.v1" },
    "packageId": { "type": "string", "minLength": 1 },
    "classification": { "const": "TEMPORARY_NON_CANONICAL" },
    "authority": { "const": "NONE" },
    "watermark": { "const": "INTERNAL WORKING DRAFT — NOT APPROVED — NOT FOR MARKETPLACE SUBMISSION" },
    "generatedAt": { "type": "string", "format": "date-time" },
    "productTruthState": { "const": "STAFF_INPUT_UNVERIFIED" },
    "requiresTrackBRevalidation": { "const": true },
    "keywordAccounting": {
      "type": "object",
      "additionalProperties": false,
      "required": ["inputObservations", "accountedObservations", "complete"],
      "properties": {
        "inputObservations": { "type": "integer", "minimum": 0 },
        "accountedObservations": { "type": "integer", "minimum": 0 },
        "complete": { "const": true }
      }
    },
    "bindings": {
      "type": "object",
      "additionalProperties": false,
      "required": ["donorCommit", "policyContractId", "policyContractHash", "claimTaxonomyVersion", "claimValidatorVersion", "ipCorpusVersion", "parserVersion", "strategyVersion"],
      "properties": {
        "donorCommit": { "type": "string" },
        "policyContractId": { "type": "string" },
        "policyContractHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "claimTaxonomyVersion": { "type": "string" },
        "claimValidatorVersion": { "type": "string" },
        "ipCorpusVersion": { "type": "string" },
        "parserVersion": { "type": "string" },
        "strategyVersion": { "type": "string" }
      }
    },
    "components": {
      "type": "array",
      "minItems": 9,
      "maxItems": 9,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "sha256", "bytes", "mediaType"],
        "properties": {
          "name": {
            "enum": [
              "01_PRODUCT_TRUTH.json",
              "02_RESEARCH_SOURCE_MANIFEST.json",
              "03_AMAZON_DRAFT.json",
              "03_AMAZON_DRAFT.csv",
              "03_AMAZON_DRAFT.txt",
              "04_KEYWORD_DISPOSITION.csv",
              "05_CLAIM_IP_POLICY_REPORT.json",
              "06_PPC_REVIEW.csv",
              "07_TRACK_B_IMPORT_RECEIPT_TEMPLATE.json"
            ]
          },
          "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
          "bytes": { "type": "integer", "minimum": 0 },
          "mediaType": { "type": "string" }
        }
      }
    }
  },
  "allOf": [
    { "properties": { "components": { "type": "array", "contains": { "type": "object", "properties": { "name": { "const": "01_PRODUCT_TRUTH.json" } }, "required": ["name"] } } } },
    { "properties": { "components": { "type": "array", "contains": { "type": "object", "properties": { "name": { "const": "02_RESEARCH_SOURCE_MANIFEST.json" } }, "required": ["name"] } } } },
    { "properties": { "components": { "type": "array", "contains": { "type": "object", "properties": { "name": { "const": "03_AMAZON_DRAFT.json" } }, "required": ["name"] } } } },
    { "properties": { "components": { "type": "array", "contains": { "type": "object", "properties": { "name": { "const": "03_AMAZON_DRAFT.csv" } }, "required": ["name"] } } } },
    { "properties": { "components": { "type": "array", "contains": { "type": "object", "properties": { "name": { "const": "03_AMAZON_DRAFT.txt" } }, "required": ["name"] } } } },
    { "properties": { "components": { "type": "array", "contains": { "type": "object", "properties": { "name": { "const": "04_KEYWORD_DISPOSITION.csv" } }, "required": ["name"] } } } },
    { "properties": { "components": { "type": "array", "contains": { "type": "object", "properties": { "name": { "const": "05_CLAIM_IP_POLICY_REPORT.json" } }, "required": ["name"] } } } },
    { "properties": { "components": { "type": "array", "contains": { "type": "object", "properties": { "name": { "const": "06_PPC_REVIEW.csv" } }, "required": ["name"] } } } },
    { "properties": { "components": { "type": "array", "contains": { "type": "object", "properties": { "name": { "const": "07_TRACK_B_IMPORT_RECEIPT_TEMPLATE.json" } }, "required": ["name"] } } } }
  ]
}
