{
  "schemaVersion": 1,
  "includeTrees": [
    "server/database"
  ],
  "includeFiles": [
    "server/projectStateRegistry.js"
  ],
  "excludeFiles": [
    "server/database/defaultAgents.js",
    "server/database/testFixtures.js"
  ],
  "runtimeSchemaScanTrees": [
    "server",
    "shared",
    "scripts"
  ],
  "runtimeSchemaSymlinkPolicy": "FORBID",
  "bootstrapExtraction": {
    "path": "server/server.js",
    "startMarker": "// Initialize DB schema",
    "endMarker": "const ensureTestDatabaseFixtures"
  }
}
